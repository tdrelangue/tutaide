generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                        String                     @id @default(cuid())
  email                     String                     @unique
  name                      String?
  passwordHash              String
  role                      UserRole                   @default(USER)
  archivedAt                DateTime?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  signature                 String?
  /// Organisation ("structure") the account belongs to. Null = solo account.
  orgId                     String?
  organization              Organization?              @relation(fields: [orgId], references: [id], onDelete: SetNull)
  /// Working role inside the organisation. Null = no access to dossiers
  /// (e.g. an IT administrator who only has the admin right).
  orgRole                   OrgRole?
  /// Access to the organisation admin panel (/structure) — nothing else.
  isOrgAdmin                Boolean                    @default(false)
  assistantAssignments      AssistantAssignment[]      @relation("AssignmentAssistant")
  mandataireAssignments     AssistantAssignment[]      @relation("AssignmentMandataire")
  /// Paying account: must hold an active Stripe subscription. False = free
  /// account (admin-created accounts default to free; self-signup sets true).
  billingRequired           Boolean                    @default(false)
  /// Entreprise plan: custom yearly price in euro cents, set by the admin.
  /// Null = individual plan (STRIPE_PRICE_INDIVIDUAL).
  billingCustomAmountCents  Int?
  /// Paying accounts only: date of the first 30 € charge, set by the admin for
  /// existing clients. Before it, full access + card registration at 0 €
  /// (Stripe trial_end). After it without a card: blocked like any paying account.
  billingStartsAt           DateTime?
  /// « Agenda » paid add-on granted for free by the admin (like a free account).
  agendaGranted             Boolean                    @default(false)
  agendaSettings            AgendaSettings?
  agendaContacts            AgendaContact[]
  agendaPlaces              AgendaPlace[]
  agendaRules               AgendaRule[]
  agendaAppointments        AgendaAppointment[]
  agendaItems               AgendaItem[]
  agendaPins                AgendaPin[]
  agendaRuleAnswers         AgendaRuleAnswer[]
  agendaOccurrenceOverrides AgendaOccurrenceOverride[]
  agendaRouteCache          AgendaRouteCache[]
  notificationReads         NotificationRead[]
  notificationsCreated      AppNotification[]          @relation("NotificationAuthor")
  notificationsTargeted     AppNotification[]          @relation("NotificationTarget")
  documents                 Document[]
  dossiers                  Dossier[]
  batches                   EmailBatch[]
  sendEvents                EmailSendEvent[]
  templates                 EmailTemplate[]
  smtpConfig                SmtpConfig?
  moduleConfigs             ModuleConfig[]
  resetTokens               PasswordResetToken[]

  @@index([email])
  @@index([orgId])
}

model Dossier {
  id                String           @id @default(cuid())
  fullName          String
  moduleType        ModuleType       @default(APA)
  priority          DossierPriority  @default(NORMAL)
  status            DossierStatus    @default(ACTIVE)
  notes             String?
  primaryEmail      String?
  ccEmails          String[]         @default([])
  bccEmails         String[]         @default([])
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  groupId           String?
  // Kept only so the currently-installed/running app build (compiled before
  // this column was removed) doesn't error out querying a missing column.
  // Not used by current app code — safe to drop once that instance is retired.
  linkedDossierId   String?          @unique
  userId            String
  /// Who created it (an assistant may create a dossier owned by an MJPM).
  createdById       String?
  defaultTemplateId String?
  sendingFrequency  SendingFrequency @default(QUARTERLY)
  documents         Document[]
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sendEvents        EmailSendEvent[]
  defaultTemplate   EmailTemplate?   @relation("DossierDefaultTemplate", fields: [defaultTemplateId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([moduleType])
  @@index([fullName])
  @@index([priority])
  @@index([status])
  @@index([updatedAt])
  @@index([defaultTemplateId])
  @@index([groupId])
}

model Document {
  id               String                     @id @default(cuid())
  filename         String
  blobUrl          String
  size             Int
  mimeType         String                     @default("application/pdf")
  createdAt        DateTime                   @default(now())
  /// Owner = the dossier's owner (MJPM), whoever uploaded it.
  userId           String
  /// Who actually uploaded it (an assistant, or the owner).
  uploadedById     String?
  dossierId        String
  dossier          Dossier                    @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  user             User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachedToEvents EmailSendEventAttachment[]

  @@index([userId])
  @@index([dossierId])
  @@index([createdAt])
}

model EmailTemplate {
  id                     String           @id @default(cuid())
  name                   String
  subject                String
  body                   String
  category               TemplateCategory @default(APA)
  isDefault              Boolean          @default(false)
  isGlobal               Boolean          @default(false)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  userId                 String?
  dossierId              String?
  user                   User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  dossiersUsingAsDefault Dossier[]        @relation("DossierDefaultTemplate")

  @@index([userId])
  @@index([category])
  @@index([dossierId])
  @@index([isGlobal])
}

model EmailBatch {
  id          String           @id @default(cuid())
  description String?
  moduleType  ModuleType?
  createdAt   DateTime         @default(now())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sendEvents  EmailSendEvent[]

  @@index([userId])
  @@index([createdAt])
  @@index([moduleType])
}

model EmailSendEvent {
  id            String                     @id @default(cuid())
  status        EmailSendStatus            @default(PENDING)
  errorMessage  String?
  moduleType    ModuleType?
  emailType     EmailType                  @default(STANDARD)
  emailReason   EmailReason?
  recipients    String[]
  ccRecipients  String[]                   @default([])
  bccRecipients String[]                   @default([])
  subject       String
  body          String
  createdAt     DateTime                   @default(now())
  sentAt        DateTime?
  /// Owner = the dossier's owner (MJPM).
  userId        String
  /// Who clicked send (an assistant, or the owner).
  sentById      String?
  dossierId     String?
  batchId       String?
  batch         EmailBatch?                @relation(fields: [batchId], references: [id])
  dossier       Dossier?                   @relation(fields: [dossierId], references: [id])
  user          User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachments   EmailSendEventAttachment[]

  @@index([userId])
  @@index([dossierId])
  @@index([batchId])
  @@index([status])
  @@index([moduleType])
  @@index([emailType])
  @@index([createdAt])
}

model EmailSendEventAttachment {
  id          String         @id @default(cuid())
  sendEventId String
  documentId  String
  document    Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  sendEvent   EmailSendEvent @relation(fields: [sendEventId], references: [id], onDelete: Cascade)

  @@unique([sendEventId, documentId])
  @@index([sendEventId])
  @@index([documentId])
}

model SmtpConfig {
  id                String       @id @default(cuid())
  provider          SmtpProvider @default(OTHER)
  smtpHost          String
  smtpPort          Int          @default(587)
  secure            Boolean      @default(true)
  username          String
  encryptedPassword String
  fromName          String
  fromEmail         String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  userId            String       @unique
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ModuleConfig {
  id               String     @id @default(cuid())
  moduleType       ModuleType
  destinationEmail String
  imapFolder       String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  userId           String
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleType])
  @@index([userId])
}

/// A company/association using Tutellia with several people ("structure").
model Organization {
  id                       String            @id @default(cuid())
  name                     String
  /// Shared documents folder every member should choose on their PC
  /// (e.g. "OneDrive – UDAF/Tutellia"); shown to members, set by the admin.
  sharedFolderHint         String?
  /// Licence key of a self-hosted server (checked by that server against
  /// tutaide.vercel.app/api/billing/license). Null = cloud organisation.
  licenseKey               String?           @unique
  archivedAt               DateTime?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  /// One subscription for the whole structure (its members' own billing
  /// fields are ignored while they belong to it). False = offered.
  billingRequired          Boolean           @default(false)
  /// Standard offer (price + account limit). Null = specific price below.
  billingOfferId           String?
  billingOffer             BillingOffer?     @relation(fields: [billingOfferId], references: [id], onDelete: Restrict)
  /// Negotiated deal: yearly price in euro cents, used when no offer is set.
  billingCustomAmountCents Int?
  /// Negotiated deal: maximum active accounts. Null = no limit.
  billingCustomMaxSeats    Int?
  /// Date of the first charge (existing clients). Before it, full access.
  billingStartsAt          DateTime?
  members                  User[]
  smtpConfig               OrgSmtpConfig?
  moduleConfigs            OrgModuleConfig[]
  auditEvents              OrgAuditEvent[]

  @@index([billingOfferId])
}

/// Standard structure offer set by OrigAI's super-administrator ("Offre 10
/// comptes — 2 400 € / an"). Archived offers stay on the structures that have
/// them but can no longer be chosen.
model BillingOffer {
  id                String         @id @default(cuid())
  name              String
  yearlyAmountCents Int
  /// Maximum active accounts. Null = no limit.
  maxSeats          Int?
  archivedAt        DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  organizations     Organization[]
}

/// Journal of every change made in the organisation admin panel (who did
/// what to whom). Never contains dossier or protected-person data.
model OrgAuditEvent {
  id           String       @id @default(cuid())
  orgId        String
  /// Who acted (the organisation admin, or OrigAI while logged in as them).
  actorId      String?
  /// Set when OrigAI's super-administrator acted while logged in as the admin.
  realActorId  String?
  action       String
  targetId     String?
  details      String?
  /// What exactly changed, so the change can be undone precisely (JSON).
  undoData     String?
  undoneAt     DateTime?
  createdAt    DateTime     @default(now())
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
}

/// An assistant works on the dossiers of the MJPMs assigned to them
/// (many-to-many, managed by the organisation admin).
model AssistantAssignment {
  assistantId  String
  mandataireId String
  createdAt    DateTime @default(now())
  createdById  String?
  assistant    User     @relation("AssignmentAssistant", fields: [assistantId], references: [id], onDelete: Cascade)
  mandataire   User     @relation("AssignmentMandataire", fields: [mandataireId], references: [id], onDelete: Cascade)

  @@id([assistantId, mandataireId])
  @@index([mandataireId])
}

/// The organisation's shared mailbox: every member sends through it.
model OrgSmtpConfig {
  id                String       @id @default(cuid())
  provider          SmtpProvider @default(OTHER)
  smtpHost          String
  smtpPort          Int          @default(587)
  secure            Boolean      @default(true)
  username          String
  encryptedPassword String
  fromName          String
  fromEmail         String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  orgId             String       @unique
  organization      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

/// Organisation-wide module destination (organism email, IMAP folder).
model OrgModuleConfig {
  id               String       @id @default(cuid())
  moduleType       ModuleType
  destinationEmail String
  imapFolder       String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  orgId            String
  organization     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, moduleType])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Message written by the software admin, shown under the bell in the app header.
model AppNotification {
  id          String               @id @default(cuid())
  title       String
  body        String
  /// Optional in-app path for an "Ouvrir" button, e.g. "/settings?tab=abonnement".
  linkPath    String?
  audience    NotificationAudience @default(ALL)
  createdAt   DateTime             @default(now())
  createdById String?
  createdBy   User?                @relation("NotificationAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  reads       NotificationRead[]

  /// Set for messages addressed to one user (automatic payment reminders); null = broadcast.
  targetUserId String?
  targetUser   User?   @relation("NotificationTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([targetUserId])
  @@index([createdAt])
}

model NotificationRead {
  userId         String
  notificationId String
  readAt         DateTime        @default(now())
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  notification   AppNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@id([userId, notificationId])
}

enum AgendaPeriod {
  WEEK
  MONTH
  QUARTER
  YEAR
}

enum AgendaEndReason {
  DECES
  DESSAISISSEMENT
  MAINLEVEE
  TRANSFERT
  AUTRE
}

enum NotificationAudience {
  ALL
  PAYING
}

/// Key/value settings editable by the software admin (e.g. "updater.endpoint").
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Singleton row (fixed id "system") holding the app-wide SMTP config used
/// to send account-recovery emails. Admin-only, independent of per-user SmtpConfig.
model SystemConfig {
  id                String   @id @default("system")
  smtpHost          String
  smtpPort          Int      @default(587)
  secure            Boolean  @default(true)
  username          String
  encryptedPassword String
  fromName          String
  fromEmail         String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

enum ModuleType {
  APA
  ASH
  PCH
}

enum DossierPriority {
  NORMAL
  PRIORITAIRE
  URGENT
}

enum DossierStatus {
  ACTIVE
  CLOSED
}

enum TemplateCategory {
  APA
  ASH
  PCH
  DERNIER_DECES
  DERNIER_DESSAISISSEMENT
  CUSTOM
}

enum EmailSendStatus {
  PENDING
  SENT
  FAILED
}

enum EmailType {
  STANDARD
  DERNIER
}

enum EmailReason {
  DECES
  DESSAISISSEMENT
}

enum SmtpProvider {
  GMAIL
  OUTLOOK
  OTHER
}

enum OrgRole {
  MANDATAIRE
  ASSISTANT
}

enum UserRole {
  USER
  ADMIN
}

enum SendingFrequency {
  MONTHLY
  QUARTERLY
}

/// « Agenda » add-on: the MJPM's planning settings (one per MJPM, the owner).
model AgendaSettings {
  id              String   @id @default(cuid())
  ownerId         String   @unique
  /// Addresses and points ("lat,lon") are encrypted (AES-256-GCM, src/lib/agenda/sealed.ts):
  /// a name plus readable coordinates would reveal the home (decision 2026-10-15).
  homeAddress     String?
  homePoint       String?
  homePrecision   String?
  officeAddress   String?
  officePoint     String?
  officePrecision String?
  /// ISO weekdays worked (1 = Monday … 7 = Sunday).
  workDays        Int[]    @default([1, 2, 3, 4, 5])
  /// Minutes after midnight, wall-clock time in `timezone`. dayEnd = wished end, drive home included.
  dayStartMin     Int      @default(510)
  dayEndMin       Int      @default(1080)
  /// Strict limit, drive home included. Null = same as dayEndMin.
  dayEndLimitMin  Int?     @default(1140)
  /// Null = no lunch break.
  lunchStartMin   Int?     @default(750)
  lunchEndMin     Int?     @default(810)
  defaultVisitMin Int      @default(60)
  timezone        String   @default("Europe/Paris")
  /// Optimistic locking: the MJPM and an assistant may edit at the same time.
  version         Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  owner           User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}

/// « Agenda » add-on: the address book (protected persons, family, judges, professionals).
model AgendaContact {
  id                 String                         @id @default(cuid())
  ownerId            String
  createdById        String?
  category           AgendaContactCategory
  fullName           String
  /// "Fils de Jean Bonneau", "Juge des contentieux de la protection"…
  role               String?
  /// Family member → the protected person they belong to (same owner, enforced).
  linkedContactId    String?
  /// Imported from the dossiers: their shared groupId, or the single dossier's id.
  dossierGroupKey    String?
  /// Not available before this time (minutes), e.g. « pas avant 10 h ».
  notBeforeMin       Int?
  /// Encrypted (may hold health information).
  notes              String?
  // Regular visits (protected persons only; all null = no regular visits).
  visitsPerPeriod    Int?
  visitPeriod        AgendaPeriod?
  visitPriority      AgendaPriority?
  visitMin           Int?
  lastVisitOn        DateTime?                      @db.Date
  prefDayDow         Int?
  prefDayStrength    AgendaStrength?
  status             AgendaContactStatus            @default(ACTIVE)
  endReason          AgendaEndReason?
  endedOn            DateTime?                      @db.Date
  createdAt          DateTime                       @default(now())
  updatedAt          DateTime                       @updatedAt
  owner              User                           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  linkedContact      AgendaContact?                 @relation("AgendaContactLink", fields: [linkedContactId, ownerId], references: [id, ownerId], onDelete: NoAction, onUpdate: NoAction)
  linkedFrom         AgendaContact[]                @relation("AgendaContactLink")
  places             AgendaPlace[]
  availabilities     AgendaAvailability[]
  participations     AgendaAppointmentParticipant[]
  itemRefs           AgendaItem[]
  itemParticipations AgendaItemParticipant[]
  pins               AgendaPin[]
  overrides          AgendaOccurrenceOverride[]

  @@unique([id, ownerId])
  @@unique([ownerId, dossierGroupKey])
  @@index([ownerId, category, status])
  @@index([linkedContactId])
}

/// An address: a contact's (position 0 = default) or a free place of the owner.
model AgendaPlace {
  id           String              @id @default(cuid())
  ownerId      String
  /// Null = a free place (« Cabinet dentaire »).
  contactId    String?
  label        String
  /// Encrypted, like `point` ("lat,lon"); the planner decrypts both when it loads the agenda.
  address      String
  point        String
  precision    String?
  position     Int                 @default(0)
  owner        User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  contact      AgendaContact?      @relation(fields: [contactId, ownerId], references: [id, ownerId], onDelete: Cascade)
  appointments AgendaAppointment[]

  @@unique([id, ownerId])
  @@index([ownerId])
  @@index([contactId, position])
}

/// A contact's recurring availability, e.g. weekdays 17:00–19:00.
model AgendaAvailability {
  id        String        @id @default(cuid())
  contactId String
  dows      Int[]
  fromMin   Int
  toMin     Int
  contact   AgendaContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
}

/// « Mes créneaux »: unavailability (all day or hours, at the office or not), vacation, visit cap.
/// Which columns are filled depends on `type`; validated by the service (zod).
model AgendaRule {
  id        String         @id @default(cuid())
  ownerId   String
  type      AgendaRuleType
  label     String
  strength  AgendaStrength @default(HARD)
  dow       Int?
  allDay    Boolean?
  fromMin   Int?
  toMin     Int?
  atOffice  Boolean        @default(false)
  maxVisits Int?
  fromDate  DateTime?      @db.Date
  toDate    DateTime?      @db.Date
  createdAt DateTime       @default(now())
  owner     User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}

/// An appointment to place (in a week, between two dates) or at a fixed time.
model AgendaAppointment {
  id           String                         @id @default(cuid())
  ownerId      String
  createdById  String?
  title        String
  placeKind    AgendaPlaceKind
  /// Set when placeKind = PLACE (same owner, enforced). A place cannot be deleted while used.
  placeId      String?
  durationMin  Int
  whenKind     AgendaWhenKind
  date         DateTime?                      @db.Date
  timeMin      Int?
  fromDate     DateTime?                      @db.Date
  toDate       DateTime?                      @db.Date
  priority     AgendaPriority                 @default(NORMAL)
  version      Int                            @default(0)
  createdAt    DateTime                       @default(now())
  updatedAt    DateTime                       @updatedAt
  owner        User                           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  place        AgendaPlace?                   @relation(fields: [placeId, ownerId], references: [id, ownerId], onDelete: NoAction, onUpdate: NoAction)
  participants AgendaAppointmentParticipant[]
  items        AgendaItem[]
  pins         AgendaPin[]

  @@unique([id, ownerId])
  @@index([ownerId])
  @@index([placeId])
}

model AgendaAppointmentParticipant {
  appointmentId String
  contactId     String
  ownerId       String
  appointment   AgendaAppointment @relation(fields: [appointmentId, ownerId], references: [id, ownerId], onDelete: Cascade)
  contact       AgendaContact     @relation(fields: [contactId, ownerId], references: [id, ownerId], onDelete: Cascade)

  @@id([appointmentId, contactId])
  @@index([contactId])
}

/// The VALIDATED planning: nothing else is the planning (rule 8). Place, date and time
/// are frozen at validation. MISSED = « N'a pas eu lieu »; CANCELLED = its appointment
/// or contact was deleted. Kept for consultation, then purged (retention, see below).
model AgendaItem {
  id            String                  @id @default(cuid())
  ownerId       String
  /// The engine's item id (visit occurrence `contactId@due`, or appointment id).
  /// Unique among this owner's items; once MISSED/CANCELLED it becomes `<status>:<id>`
  /// so the same occurrence can be planned and validated again.
  itemKey       String
  kind          AgendaItemKind
  appointmentId String?
  /// The protected person of a regular visit.
  contactId     String?
  title         String
  placeLabel    String
  /// Encrypted, like AgendaPin.placeAddress.
  placeAddress  String
  /// Encrypted "lat,lon". Null for a video call.
  placePoint    String?
  placeRemote   Boolean                 @default(false)
  date          DateTime                @db.Date
  startMin      Int
  endMin        Int
  priority      AgendaPriority
  earliestDate  DateTime                @db.Date
  latestDate    DateTime                @db.Date
  fixed         Boolean                 @default(false)
  movable       Boolean                 @default(false)
  moved         Boolean                 @default(false)
  status        AgendaItemStatus        @default(VALIDATED)
  statusAt      DateTime?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  owner         User                    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  appointment   AgendaAppointment?      @relation(fields: [appointmentId, ownerId], references: [id, ownerId], onDelete: NoAction, onUpdate: NoAction)
  contact       AgendaContact?          @relation(fields: [contactId, ownerId], references: [id, ownerId], onDelete: NoAction, onUpdate: NoAction)
  participants  AgendaItemParticipant[]

  @@unique([id, ownerId])
  @@unique([ownerId, itemKey])
  @@index([ownerId, date])
  @@index([ownerId, status, date])
  @@index([appointmentId])
  @@index([contactId])
}

model AgendaItemParticipant {
  itemId    String
  contactId String
  ownerId   String
  item      AgendaItem    @relation(fields: [itemId, ownerId], references: [id, ownerId], onDelete: Cascade)
  contact   AgendaContact @relation(fields: [contactId, ownerId], references: [id, ownerId], onDelete: Cascade)

  @@id([itemId, contactId])
  @@index([contactId])
}

/// A proposed block the user dragged elsewhere before validation (removed at validation).
model AgendaPin {
  id             String             @id @default(cuid())
  ownerId        String
  itemKey        String
  kind           AgendaItemKind
  appointmentId  String?
  contactId      String?
  title          String
  participantIds String[]
  placeLabel     String
  /// Encrypted, like placePoint ("lat,lon").
  placeAddress   String
  placePoint     String?
  placeRemote    Boolean            @default(false)
  durationMin    Int
  priority       AgendaPriority
  date           DateTime           @db.Date
  startMin       Int
  createdAt      DateTime           @default(now())
  owner          User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  appointment    AgendaAppointment? @relation(fields: [appointmentId, ownerId], references: [id, ownerId], onDelete: Cascade)
  contact        AgendaContact?     @relation(fields: [contactId, ownerId], references: [id, ownerId], onDelete: Cascade)

  @@unique([ownerId, itemKey])
  @@index([ownerId, date])
  @@index([appointmentId])
  @@index([contactId])
}

/// Answers to « Important » questions and refused « Souhaité » exceptions.
/// ruleKey = AgendaRule.id, or "pref:<contactId>" for a contact's preferred day.
model AgendaRuleAnswer {
  ownerId String
  ruleKey String
  answer  AgendaAnswer?
  refused Boolean       @default(false)
  owner   User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@id([ownerId, ruleKey])
}

/// « Pas cette fois » and per-occurrence priority of a regular visit.
model AgendaOccurrenceOverride {
  ownerId       String
  occurrenceKey String
  contactId     String
  /// Due date of the occurrence: rows older than a few months are purged.
  dueOn         DateTime        @db.Date
  skipped       Boolean         @default(false)
  priority      AgendaPriority?
  owner         User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  contact       AgendaContact   @relation(fields: [contactId, ownerId], references: [id, ownerId], onDelete: Cascade)

  @@id([ownerId, occurrenceKey])
  @@index([ownerId, dueOn])
  @@index([contactId])
}

/// IGN road times already asked, per MJPM. pairKey = HMAC of the rounded coordinate
/// pair (no readable location). Purged after 90 days.
model AgendaRouteCache {
  ownerId   String
  pairKey   String
  km        Float
  minutes   Float
  fetchedAt DateTime @default(now())
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@id([ownerId, pairKey])
  @@index([fetchedAt])
}

