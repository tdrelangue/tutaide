generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String               @id @default(cuid())
  email                    String               @unique
  name                     String?
  passwordHash             String
  role                     UserRole             @default(USER)
  archivedAt               DateTime?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  signature                String?
  orgId                    String?
  /// Paying account: must hold an active Stripe subscription. False = free
  /// account (admin-created accounts default to free; self-signup sets true).
  billingRequired          Boolean              @default(false)
  /// Entreprise plan: custom yearly price in euro cents, set by the admin.
  /// Null = individual plan (STRIPE_PRICE_INDIVIDUAL).
  billingCustomAmountCents Int?
  documents                Document[]
  dossiers                 Dossier[]
  batches                  EmailBatch[]
  sendEvents               EmailSendEvent[]
  templates                EmailTemplate[]
  smtpConfig               SmtpConfig?
  moduleConfigs            ModuleConfig[]
  resetTokens              PasswordResetToken[]

  @@index([email])
  @@index([orgId])
}

model Dossier {
  id                String           @id @default(cuid())
  fullName          String
  moduleType        ModuleType       @default(APA)
  priority          DossierPriority  @default(NORMAL)
  status            DossierStatus    @default(ACTIVE)
  notes             String?
  primaryEmail      String?
  ccEmails          String[]         @default([])
  bccEmails         String[]         @default([])
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  groupId           String?
  // Kept only so the currently-installed/running app build (compiled before
  // this column was removed) doesn't error out querying a missing column.
  // Not used by current app code — safe to drop once that instance is retired.
  linkedDossierId   String?          @unique
  userId            String
  defaultTemplateId String?
  sendingFrequency  SendingFrequency @default(QUARTERLY)
  documents         Document[]
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sendEvents        EmailSendEvent[]
  defaultTemplate   EmailTemplate?   @relation("DossierDefaultTemplate", fields: [defaultTemplateId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([moduleType])
  @@index([fullName])
  @@index([priority])
  @@index([status])
  @@index([updatedAt])
  @@index([defaultTemplateId])
  @@index([groupId])
}

model Document {
  id               String                     @id @default(cuid())
  filename         String
  blobUrl          String
  size             Int
  mimeType         String                     @default("application/pdf")
  createdAt        DateTime                   @default(now())
  userId           String
  dossierId        String
  dossier          Dossier                    @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  user             User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachedToEvents EmailSendEventAttachment[]

  @@index([userId])
  @@index([dossierId])
  @@index([createdAt])
}

model EmailTemplate {
  id                     String           @id @default(cuid())
  name                   String
  subject                String
  body                   String
  category               TemplateCategory @default(APA)
  isDefault              Boolean          @default(false)
  isGlobal               Boolean          @default(false)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  userId                 String?
  dossierId              String?
  user                   User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  dossiersUsingAsDefault Dossier[]        @relation("DossierDefaultTemplate")

  @@index([userId])
  @@index([category])
  @@index([dossierId])
  @@index([isGlobal])
}

model EmailBatch {
  id          String           @id @default(cuid())
  description String?
  moduleType  ModuleType?
  createdAt   DateTime         @default(now())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sendEvents  EmailSendEvent[]

  @@index([userId])
  @@index([createdAt])
  @@index([moduleType])
}

model EmailSendEvent {
  id            String                     @id @default(cuid())
  status        EmailSendStatus            @default(PENDING)
  errorMessage  String?
  moduleType    ModuleType?
  emailType     EmailType                  @default(STANDARD)
  emailReason   EmailReason?
  recipients    String[]
  ccRecipients  String[]                   @default([])
  bccRecipients String[]                   @default([])
  subject       String
  body          String
  createdAt     DateTime                   @default(now())
  sentAt        DateTime?
  userId        String
  dossierId     String?
  batchId       String?
  batch         EmailBatch?                @relation(fields: [batchId], references: [id])
  dossier       Dossier?                   @relation(fields: [dossierId], references: [id])
  user          User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachments   EmailSendEventAttachment[]

  @@index([userId])
  @@index([dossierId])
  @@index([batchId])
  @@index([status])
  @@index([moduleType])
  @@index([emailType])
  @@index([createdAt])
}

model EmailSendEventAttachment {
  id          String         @id @default(cuid())
  sendEventId String
  documentId  String
  document    Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  sendEvent   EmailSendEvent @relation(fields: [sendEventId], references: [id], onDelete: Cascade)

  @@unique([sendEventId, documentId])
  @@index([sendEventId])
  @@index([documentId])
}

model SmtpConfig {
  id                String       @id @default(cuid())
  provider          SmtpProvider @default(OTHER)
  smtpHost          String
  smtpPort          Int          @default(587)
  secure            Boolean      @default(true)
  username          String
  encryptedPassword String
  fromName          String
  fromEmail         String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  userId            String       @unique
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ModuleConfig {
  id               String     @id @default(cuid())
  moduleType       ModuleType
  destinationEmail String
  imapFolder       String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  userId           String
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleType])
  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Singleton row (fixed id "system") holding the app-wide SMTP config used
/// to send account-recovery emails. Admin-only, independent of per-user SmtpConfig.
model SystemConfig {
  id                String   @id @default("system")
  smtpHost          String
  smtpPort          Int      @default(587)
  secure            Boolean  @default(true)
  username          String
  encryptedPassword String
  fromName          String
  fromEmail         String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

enum ModuleType {
  APA
  ASH
  PCH
}

enum DossierPriority {
  NORMAL
  PRIORITAIRE
  URGENT
}

enum DossierStatus {
  ACTIVE
  CLOSED
}

enum TemplateCategory {
  APA
  ASH
  PCH
  DERNIER_DECES
  DERNIER_DESSAISISSEMENT
  CUSTOM
}

enum EmailSendStatus {
  PENDING
  SENT
  FAILED
}

enum EmailType {
  STANDARD
  DERNIER
}

enum EmailReason {
  DECES
  DESSAISISSEMENT
}

enum SmtpProvider {
  GMAIL
  OUTLOOK
  OTHER
}

enum UserRole {
  USER
  ADMIN
}

enum SendingFrequency {
  MONTHLY
  QUARTERLY
}
