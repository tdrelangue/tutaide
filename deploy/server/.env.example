# Created by init.sh / init.ps1 — do not copy this file by hand.
# Keep the real .env secret: it holds the database password and the keys.

# Address staff use to reach Tutellia (DNS name of this server)
TUTELLIA_DOMAIN=tutellia.structure.local
# Certificate: internal | an email (public Let's Encrypt) | /certs/cert.pem /certs/key.pem
TUTELLIA_TLS=internal

# Version of Tutellia to run (changed by update.sh / update.ps1)
TUTELLIA_IMAGE=tutellia-server
TUTELLIA_TAG=2.1.0

# Generated secrets (never share, never change by hand: ENCRYPTION_KEY protects stored mail passwords)
DB_PASSWORD=
AUTH_SECRET=
ENCRYPTION_KEY=

# Licence key delivered by OrigAI
TUTELLIA_LICENSE_KEY=

# Ports (change only if 443/80 are already used on this server).
# With another HTTPS port, also set TUTELLIA_URL=https://<domain>:<port>
HTTPS_PORT=443
HTTP_PORT=80
TUTELLIA_URL=
