{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Tutellia desktop capabilities",
  "platforms": ["linux", "macOS", "windows"],
  "windows": ["main"],
  "remote": {
    "urls": ["http://localhost:3456/*", "http://localhost:3000/*"]
  },
  "permissions": [
    "core:default",
    "shell:allow-open",
    "updater:allow-check",
    "updater:allow-download-and-install",
    "dialog:default",
    "process:default"
  ]
}
